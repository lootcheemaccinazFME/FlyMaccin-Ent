 <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
 <application android:allowBackup="true" android:label="Demonic DAW" android:theme="@style/AppTheme" android:usesCleartextTraffic="false">
  <activity android:name=".MainActivity" android:screenOrientation="unspecified" android:exported="true" android:supportsPictureInPicture="true" android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation">
   <intent-filter>
    <action android:name="android.intent.action.MAIN"/>
